# Copy this file to `.env` before running `make up` / `docker compose up`.
#
# Host port to publish the app on (the container always listens on 3000
# internally). Defaults to 3000; override if 3000 is taken on your machine.
WEB_PORT=3000

# Single admin credential for the builder UI (/admin) and the management
# API. Change this before exposing the instance beyond your own machine.
ADMIN_PASSWORD=change-me

# Secret used to sign admin session cookies (HMAC). Set a long random value
# so sessions survive restarts; if left blank the app generates a random one
# per process (you'll be logged out on every restart). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the sqlite database file lives *inside* the container. Only change
# this if you also change the compose volume mount to match — the default
# below is paired with the `fancy-data:/data` volume in docker-compose.yml.
DATABASE_PATH=/data/app.db

# Seed the `hello-tony` quotes demo API on container start. Idempotent —
# safe to leave on; it no-ops once hello-tony already exists. Set to 0 to
# start with a completely empty instance.
SEED_ON_START=1
